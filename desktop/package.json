{
  "name": "dericbi-desktop",
  "version": "1.0.1",
  "description": "DericBI Analytics Engine — Desktop App",
  "main": "main.js",
  "author": "Deric Marangu",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --publish never",
    "publish:win": "electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.dericbi.desktop",
    "productName": "DericBI",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "build/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "Deric254",
      "repo": "Analytics",
      "releaseType": "release"
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DericBI"
    }
  }
}
