# ── DericBI Environment Variables ──────────────────────────────────────────
# Copy this file to .env for local use, or set these in Render → Environment.

# ── Login (optional) ────────────────────────────────────────────────────────
# Set LOGIN_ENABLED=true to require a password before using the app.
LOGIN_ENABLED=false
LOGIN_PASSWORD=dericbi
SECRET_KEY=change-this-to-a-random-string-in-production

# ── AI Assistant (optional) — set ONE of these to enable full AI ───────────
# Without any of these, the AI button still works using the local engine.
# NVIDIA NIM (free tier): https://build.nvidia.com
NVIDIA_API_KEY=
# Gemini (recommended — generous free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq (fastest, free): https://console.groq.com
GROQ_API_KEY=
# OpenRouter (many free models): https://openrouter.ai
OPENROUTER_KEY=

# ── Database (optional) ──────────────────────────────────────────────────────
DB_CONNECTION_STRING=

# ── Server ────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=10000
DEBUG=false
